{
    "name": "cuzy-app/humhub-suneditor",
    "description": "SunEditor rich-text field and renderer for HumHub modules, with inline image/video/audio uploads and automatic orphan-file cleanup.",
    "type": "library",
    "license": "AGPL-3.0-or-later",
    "homepage": "https://github.com/cuzy-app/humhub-suneditor",
    "authors": [
        {
            "name": "Marc FARRE",
            "homepage": "https://marc.fun",
            "role": "Developer"
        }
    ],
    "keywords": ["humhub", "yii2", "suneditor", "wysiwyg", "rich-text"],
    "autoload": {
        "psr-4": {
            "cuzyapp\\suneditor\\": "src/"
        }
    },
    "require": {
        "php": ">=8.1",
        "composer-runtime-api": "^2.0",
        "yiisoft/yii2": "^2.0",
        "yiisoft/yii2-bootstrap5": "^2.0",
        "npm-asset/suneditor": "^3.1.3"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ]
}
